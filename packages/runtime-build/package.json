{
  "name": "@blud/runtime-build",
  "version": "0.1.11",
  "description": "Headless build utilities and CLI for compiling Web Hammer runtime bundles.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "web-hammer-runtime-build": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config ../../scripts/tsup.package.config.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibe-stack/blob.git",
    "directory": "packages/runtime-build"
  },
  "bugs": {
    "url": "https://github.com/vibe-stack/blob/issues"
  },
  "homepage": "https://github.com/vibe-stack/blob/tree/main/packages/runtime-build",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/three": "^0.184.1"
  },
  "dependencies": {
    "@blud/editor-core": "*",
    "@blud/geometry-kernel": "*",
    "@blud/runtime-format": "*",
    "@blud/shared": "*",
    "fflate": "^0.8.2",
    "three": "0.184.0",
    "three-mesh-bvh": "^0.9.2"
  }
}
