{
  "name": "@blud/forest",
  "version": "0.1.0",
  "description": "Procedural forests: spline-defined stand fields, species presets, and a self-contained tree geometry generator.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
